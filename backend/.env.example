# Local defaults — copy to .env
DATABASE_URL=postgresql+psycopg://smartdispatch:smartdispatch@localhost:5432/smartdispatch
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
AUTH_STUB_DEFAULT_ROLE=admin
MATCHING_ENGINE_ENABLED=true

# Comma-separated browser origins allowed to call the API (Admin Portal + Guest web)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
