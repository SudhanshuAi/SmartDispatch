# Copy to .env and adjust as needed
DATABASE_URL=postgresql+psycopg://smartdispatch:smartdispatch@localhost:5432/smartdispatch
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
# Unused for privileged routes — admin/driver/guest all require explicit X-Role
AUTH_STUB_DEFAULT_ROLE=admin
# Set false to simulate matching-engine outage (trips + overrides still work)
MATCHING_ENGINE_ENABLED=true
