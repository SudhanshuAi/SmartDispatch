# =============================================================================
# SmartDispatch — root .gitignore
# Push source, docs, lockfiles, and .env.example only. Never secrets or deps.
# =============================================================================

# Private brief — do not publish
Assignment.md

# ----- Secrets & local env (keep *.example) -----
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.p8
*.jks
credentials*.json
service-account*.json

# ----- Python / backend -----
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.sqlite3
*.db

# ----- Node / frontends -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Admin Portal (Vite)
admin-portal/dist/
admin-portal/dist-ssr/
admin-portal/*.local

# Guest app (Expo)
guest-app/.expo/
guest-app/dist/
guest-app/web-build/
guest-app/expo-env.d.ts
guest-app/expo-qr.png
guest-app/ios/
guest-app/android/
.metro-health-check*

# ----- OS / editors -----
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# ----- Cursor / AI local -----
.cursor/
.claude/
agent-transcripts/

# ----- Logs & temp -----
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.orig

# ----- Docker / local data volumes (if ever bind-mounted) -----
data/
postgres-data/
redis-data/
